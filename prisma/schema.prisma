// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Users and Authentication
model User {
  id            String     @id @default(cuid())
  username      String     @unique
  email         String?    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  phone         String?
  role          Role       @relation(fields: [roleId], references: [id])
  roleId        String
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  // Relations
  sales         Sale[]
  returns       Return[]
  auditLogs     AuditLog[]
  backups       Backup[]
  heldBillsAsChashier HeldBill[] @relation("CashierHeldBills")

  @@index([roleId])
  @@index([username])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  permissions Permission[]
  users       User[]

  @@index([name])
}

model Permission {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  roles       Role[]

  @@index([name])
}

// Products and Categories
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  icon      String?
  color     String?
  status    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([name])
  @@index([slug])
}

model Product {
  id              String            @id @default(cuid())
  productName     String
  productCode     String            @unique
  sku             String?           @unique
  barcode         String?           @unique
  category        Category          @relation(fields: [categoryId], references: [id])
  categoryId      String
  brand           String?
  unit            Unit              @default(PIECE)
  purchasePrice   Decimal           @db.Decimal(10, 2)
  sellingPrice    Decimal           @db.Decimal(10, 2)
  mrp             Decimal?          @db.Decimal(10, 2)
  gstPercentage   Decimal           @default(0) @db.Decimal(5, 2)
  openingStock    Int               @default(0)
  currentStock    Int               @default(0)
  minimumStock    Int               @default(0)
  supplier        Supplier?         @relation(fields: [supplierId], references: [id])
  supplierId      String?
  description     String?           @db.LongText
  image           String?
  status          ProductStatus     @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  // Relations
  saleItems       SaleItem[]
  returnItems     ReturnItem[]
  inventoryTrans  InventoryTransaction[]
  inventory       Inventory?

  @@index([productCode])
  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@index([productName])
}

enum Unit {
  PIECE
  BOX
  KG
  GRAM
  LITER
  METER
  FEET
  PACKET
  DOZEN
  SET
  CARTON
  ROLL
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

model Supplier {
  id        String    @id @default(cuid())
  name      String    @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  state      String?
  pinCode   String?
  gstNumber String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([name])
  @@index([phone])
}

// Customers
model Customer {
  id             String    @id @default(cuid())
  name           String
  phone          String    @unique
  email          String?   @unique
  address        String?
  city           String?
  state          String?
  pinCode        String?
  gstNumber      String?
  totalPurchases Decimal   @default(0) @db.Decimal(12, 2)
  totalDue       Decimal   @default(0) @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  sales          Sale[]
  creditNotes    CreditNote[]
  heldBillsAsCustomer HeldBill[] @relation("CustomerHeldBills")

  @@index([phone])
  @@index([name])
}

model CreditNote {
  id        String    @id @default(cuid())
  customer  Customer  @relation(fields: [customerId], references: [id])
  customerId String
  amount    Decimal   @db.Decimal(12, 2)
  dueDate   DateTime?
  notes     String?   @db.LongText
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([customerId])
}

// Sales and Billing
model Sale {
  id              String      @id @default(cuid())
  billNumber      String      @unique
  customer        Customer?   @relation(fields: [customerId], references: [id])
  customerId      String?
  cashier         User        @relation(fields: [cashierId], references: [id])
  cashierId       String
  subtotal        Decimal     @db.Decimal(12, 2)
  discount        Decimal     @default(0) @db.Decimal(12, 2)
  discountPercent Decimal     @default(0) @db.Decimal(5, 2)
  cgst            Decimal     @default(0) @db.Decimal(12, 2)
  sgst            Decimal     @default(0) @db.Decimal(12, 2)
  igst            Decimal     @default(0) @db.Decimal(12, 2)
  roundOff        Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  saleStatus      SaleStatus  @default(COMPLETED)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  saleItems       SaleItem[]
  payment         Payment?
  returns         Return[]
  auditLog        AuditLog[]

  @@index([billNumber])
  @@index([customerId])
  @@index([cashierId])
  @@index([createdAt])
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
}

model SaleItem {
  id        String  @id @default(cuid())
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  amount    Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

// Payments
model Payment {
  id              String          @id @default(cuid())
  sale            Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId          String          @unique
  paymentMethod   PaymentMethod
  amountReceived  Decimal         @db.Decimal(12, 2)
  amountPaid      Decimal         @db.Decimal(12, 2)
  change          Decimal         @db.Decimal(12, 2)
  referenceNumber String?
  notes           String?         @db.LongText
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Split payments
  splitPayments   SplitPayment[]

  @@index([saleId])
  @@index([paymentMethod])
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  CREDIT
  BANK_TRANSFER
}

model SplitPayment {
  id        String         @id @default(cuid())
  payment   Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId String
  method    PaymentMethod
  amount    Decimal        @db.Decimal(12, 2)

  @@index([paymentId])
}

// Returns
model Return {
  id           String      @id @default(cuid())
  returnNumber String      @unique
  sale         Sale        @relation(fields: [saleId], references: [id])
  saleId       String
  initiatedBy  User        @relation(fields: [userId], references: [id])
  userId       String
  subtotal     Decimal     @db.Decimal(12, 2)
  discount     Decimal     @default(0) @db.Decimal(12, 2)
  cgst         Decimal     @default(0) @db.Decimal(12, 2)
  sgst         Decimal     @default(0) @db.Decimal(12, 2)
  igst         Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal     @db.Decimal(12, 2)
  reason       String?
  refundStatus RefundStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  returnItems  ReturnItem[]

  @@index([saleId])
  @@index([userId])
}

enum RefundStatus {
  PENDING
  APPROVED
  REFUNDED
  REJECTED
}

model ReturnItem {
  id        String  @id @default(cuid())
  return    Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  returnId  String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  amount    Decimal @db.Decimal(12, 2)

  @@index([returnId])
  @@index([productId])
}

// Inventory
model Inventory {
  id              String                   @id @default(cuid())
  product         Product                  @relation(fields: [productId], references: [id])
  productId       String                   @unique
  openingStock    Int                      @default(0)
  currentStock    Int                      @default(0)
  reservedStock   Int                      @default(0)
  availableStock  Int                      @default(0)
  totalSold       Int                      @default(0)
  totalReturned   Int                      @default(0)
  totalAdjusted   Int                      @default(0)
  stockValue      Decimal                  @default(0) @db.Decimal(12, 2)
  lastUpdated     DateTime                 @updatedAt

  // Relations
  transactions    InventoryTransaction[]

  @@index([productId])
}

model InventoryTransaction {
  id           String                @id @default(cuid())
  product      Product               @relation(fields: [productId], references: [id])
  productId    String
  inventory    Inventory?            @relation(fields: [inventoryId], references: [id])
  inventoryId  String?
  type         InventoryTransactionType
  quantity     Int
  previousQty  Int
  newQty       Int
  reason       String?
  referenceId  String?
  referenceType InventoryReferenceType?
  notes        String?               @db.LongText
  createdAt    DateTime              @default(now())

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

enum InventoryTransactionType {
  OPENING_STOCK
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  EXPIRY
  PURCHASE
  TRANSFER
}

enum InventoryReferenceType {
  SALE
  RETURN
  PURCHASE
  ADJUSTMENT
}

// Expenses
model Expense {
  id          String          @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String?         @db.LongText
  paymentMethod PaymentMethod
  billNumber  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category])
  @@index([date])
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  TRANSPORT
  SALARY
  MAINTENANCE
  SUPPLIES
  OTHER
}

// Shop Settings
model ShopSettings {
  id              String    @id @default(cuid())
  shopName        String
  address         String
  phone           String
  email           String?
  gstNumber       String?
  panNumber       String?
  shopLogo        String?
  footerText      String?   @db.LongText
  upiId           String?
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  enableGST       Boolean   @default(true)
  enableDiscount  Boolean   @default(true)
  enableCredit    Boolean   @default(true)
  currencySymbol  String    @default("₹")
  decimalPlaces   Int       @default(2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([shopName])
}

model PrinterSettings {
  id              String    @id @default(cuid())
  printerName     String
  paperWidth      Int       @default(80)
  autoprint       Boolean   @default(false)
  numberOfCopies  Int       @default(1)
  fontSize        Int       @default(1)
  showQR          Boolean   @default(false)
  showBarcode     Boolean   @default(false)
  showGST         Boolean   @default(true)
  showDiscount    Boolean   @default(true)
  showCustomer    Boolean   @default(true)
  showPhone       Boolean   @default(true)
  showPayment     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ReceiptSettings {
  id              String    @id @default(cuid())
  billNumberPrefix String  @default("BIL")
  showItemCode    Boolean   @default(true)
  showGSTBreakup  Boolean   @default(true)
  showWatermark   String?
  headerText      String?   @db.LongText
  footerText      String?   @db.LongText
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Backups
model Backup {
  id          String      @id @default(cuid())
  fileName    String      @unique
  filePath    String
  fileSize    BigInt
  createdBy   User        @relation(fields: [userId], references: [id])
  userId      String
  description String?
  status      BackupStatus @default(COMPLETED)
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

// Audit Logs
model AuditLog {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  action      String
  entity      String
  entityId    String?
  oldValue    String?   @db.LongText
  newValue    String?   @db.LongText
  details     String?   @db.LongText
  ipAddress   String?
  userAgent   String?   @db.LongText
  createdAt   DateTime  @default(now())

  sale        Sale?     @relation(fields: [saleId], references: [id])
  saleId      String?

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

// Hold Bills (Draft Sales)
model HeldBill {
  id          String      @id @default(cuid())
  billNumber  String      @unique
  cashier     User        @relation("CashierHeldBills", fields: [cashierId], references: [id])
  cashierId   String
  customer    Customer?   @relation("CustomerHeldBills", fields: [customerId], references: [id])
  customerId  String?
  items       HeldBillItem[]
  subtotal    Decimal     @db.Decimal(12, 2)
  discount    Decimal     @default(0) @db.Decimal(12, 2)
  cgst        Decimal     @default(0) @db.Decimal(12, 2)
  sgst        Decimal     @default(0) @db.Decimal(12, 2)
  igst        Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount Decimal     @db.Decimal(12, 2)
  notes       String?     @db.LongText
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  expiresAt   DateTime

  @@index([cashierId])
  @@index([customerId])
  @@index([createdAt])
}

model HeldBillItem {
  id          String      @id @default(cuid())
  heldBill    HeldBill    @relation(fields: [heldBillId], references: [id], onDelete: Cascade)
  heldBillId  String
  productId   String
  quantity    Int
  price       Decimal     @db.Decimal(10, 2)
  discount    Decimal     @default(0) @db.Decimal(10, 2)
  amount      Decimal     @db.Decimal(12, 2)

  @@index([heldBillId])
}
